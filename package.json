{
  "name": "zhongshuo",
  "version": "0.0.1",
  "private": true,
  "description": "众说：本地项目群聊多 Agent 协同工作台（正式工程；hifi-prototype/ 为交互参照原型，各自独立 package.json）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:real": "vitest run --config vitest.real.e2e.config.ts",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.3.2",
    "pdfjs-dist": "~4.10.38",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
