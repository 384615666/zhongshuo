{
  "name": "zhongshuo",
  "version": "0.0.1",
  "private": true,
  "description": "众说：本地项目群聊多 Agent 协同工作台（正式工程；hifi-prototype/ 为交互参照原型，各自独立 package.json）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:hifi": "tsc --noEmit -p tsconfig.hifi.json",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm typecheck:hifi && pnpm lint && pnpm test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:real": "vitest run --config vitest.real.e2e.config.ts",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@extend-ai/react-xlsx": "0.16.0",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "^13.0.3",
    "docx-preview": "0.4.1",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "jszip": "3.10.2",
    "koffi": "^3.3.2",
    "mammoth": "^1.13.0",
    "markdown-it": "^14.3.2",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "~4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/node-forge": "^1.3.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
